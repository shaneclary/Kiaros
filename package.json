{
  "name": "kiaros",
  "version": "2.0.0",
  "description": "Self-hosted, Claude-native personal AI executive engine",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build": "cd client && npm run build",
    "setup": "npm install && cd client && npm install",
    "install:linux": "bash install.sh",
    "service:start": "systemctl --user start kiaros",
    "service:stop": "systemctl --user stop kiaros",
    "service:restart": "systemctl --user restart kiaros",
    "service:status": "systemctl --user status kiaros",
    "service:logs": "journalctl --user -u kiaros -f"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
